# =====================================================================
# Simon Musical Instruments: environment variables
# Copy to .env for local development. Never commit real values.
# Production values live in Railway service variables (every active project).
# Docs: docs/infrastructure-and-operations.md §5
# =====================================================================

# --- Database (Postgres) ---------------------------------------------
# Local: a local Postgres (see docs/local-development.md). NEVER the production URL:
# in dev mode Payload pushes schema changes to whatever this points at.
# Production: Supabase session pooler,
#   postgresql://postgres.<project-ref>:<password>@aws-1-eu-west-1.pooler.supabase.com:5432/postgres
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/simon_local

# --- Payload CMS (required) ------------------------------------------
# openssl rand -base64 32. Rotating it logs out all admin sessions.
PAYLOAD_SECRET=

# --- Auth.js / storefront sessions (required) ------------------------
# openssl rand -base64 32. Rotating it logs out all customers.
AUTH_SECRET=
# Optional; trustHost is enabled, so the URL is derived from the request.
# AUTH_URL=http://localhost:3000

# Google OAuth ("Sign in with Google").
# Redirect URI: <origin>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Media storage: Supabase Storage via the S3 API (required for uploads)
# Supabase dashboard -> Storage -> S3 Connection. The bucket must exist (production: "media").
S3_BUCKET=media
S3_ENDPOINT=https://<project-ref>.storage.supabase.co/storage/v1/s3
S3_REGION=eu-west-1
S3_ACCESS_KEY=
S3_SECRET_KEY=

# --- Email: Resend (required for OTP, reservation and contact emails) --
RESEND_API_KEY=
EMAIL_FROM=Paul Simon <paul.simon@simoninstruments.com>

# --- Translation: DeepL (recommended) --------------------------------
# Without it, new instruments are not translated (silently skipped).
DEEPL_API_KEY=

# --- Bot protection: Cloudflare Turnstile (required in production) ----
# Without the secret, Turnstile checks are skipped (local dev). Test keys that always pass:
#   NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
#   TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Stripe (DISABLED: online payments are off, see docs/adr/0004) ---
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
# STRIPE_SECRET_KEY=sk_test_...

# --- Canonical host (optional) ---------------------------------------
# Host that all other hosts redirect to. Defaults to https://simoninstruments.com.
# Set it on preview/staging deploys so they don't redirect to production.
# NEXT_PUBLIC_SITE_URL=https://simoninstruments.com

# --- Analytics and error tracking: PostHog EU (optional) ---------------
# Off when the key is unset (local dev, CI). The key is the public project key (phc_...).
# NEXT_PUBLIC_* values are baked in at build time: set them before the build that ships.
# See docs/observability/ for what is collected (no cookies, no browser storage, no PII).
# NEXT_PUBLIC_POSTHOG_KEY=phc_...
# NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
# NEXT_PUBLIC_APP_ENV=production
# NEXT_PUBLIC_APP_VERSION=   # optional; on Railway, next.config.mjs uses RAILWAY_GIT_COMMIT_SHA
# Server-side overrides (default to the NEXT_PUBLIC_ values above):
# POSTHOG_KEY=
# POSTHOG_HOST=
# ERROR_TRACKER=posthog   # or "none" to stop sending errors (they're still logged)
# POSTHOG_DISABLED=true   # stop all server-side analytics
# LOG_LEVEL=debug         # include debug log lines
