{
  "name": "simon-musical-instruments",
  "version": "1.0.0",
  "description": "A blank template to get started with Payload 3.0",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "cross-env NODE_OPTIONS=\"--no-deprecation --max-old-space-size=8000\" next build",
    "dev": "cross-env NODE_OPTIONS=--no-deprecation next dev",
    "devsafe": "rm -rf .next && cross-env NODE_OPTIONS=--no-deprecation next dev",
    "generate:importmap": "cross-env NODE_OPTIONS=--no-deprecation payload generate:importmap",
    "generate:types": "cross-env NODE_OPTIONS=--no-deprecation payload generate:types",
    "lint": "cross-env NODE_OPTIONS=--no-deprecation eslint .",
    "payload": "cross-env NODE_OPTIONS=--no-deprecation payload",
    "start": "cross-env NODE_OPTIONS=--no-deprecation next start",
    "test": "pnpm run test:int && pnpm run test:e2e",
    "test:e2e": "cross-env NODE_OPTIONS=\"--no-deprecation --no-experimental-strip-types\" pnpm exec playwright test",
    "test:int": "cross-env NODE_OPTIONS=--no-deprecation vitest run --config ./vitest.config.mts",
    "seed": "cross-env NODE_OPTIONS=--no-deprecation tsx scripts/seed-instruments.ts"
  },
  "dependencies": {
    "@payloadcms/db-postgres": "3.92.1",
    "@payloadcms/next": "3.92.1",
    "@payloadcms/richtext-lexical": "3.92.1",
    "@payloadcms/storage-s3": "^3.92.1",
    "@payloadcms/ui": "3.92.1",
    "@radix-ui/react-accordion": "^1.3.1",
    "@radix-ui/react-checkbox": "^1.4.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-label": "^2.1.17",
    "@radix-ui/react-radio-group": "^1.5.1",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-separator": "^1.2.0",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-tabs": "^1.2.1",
    "@react-email/components": "^1.0.12",
    "@react-pdf/renderer": "^4.9.0",
    "@stripe/react-stripe-js": "^5.4.1",
    "@stripe/stripe-js": "^8.6.0",
    "@tailwindcss/postcss": "^4.3.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cross-env": "^7.0.3",
    "deepl-node": "^1.28.1",
    "dotenv": "16.4.7",
    "graphql": "^16.8.1",
    "lucide-react": "^0.562.0",
    "next": "16.4.3",
    "next-auth": "5.0.0-beta.32",
    "next-intl": "^4.14.9",
    "payload": "3.92.1",
    "payload-totp": "3.0.6",
    "postcss": "^8.5.32",
    "posthog-js": "^1.441.2",
    "posthog-node": "^5.59.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-zoom-pan-pinch": "^3.7.0",
    "resend": "^6.35.0",
    "server-only": "0.0.1",
    "sharp": "0.35.5",
    "stripe": "^20.1.0",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@playwright/test": "1.64.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "^22.5.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "4.5.2",
    "eslint": "^9.16.0",
    "eslint-config-next": "16.4.3",
    "jsdom": "26.1.0",
    "playwright": "1.64.1",
    "playwright-core": "1.64.1",
    "prettier": "^3.9.10",
    "railway": "3.16.0",
    "tsx": "^4.23.15",
    "typescript": "5.7.3",
    "vite-tsconfig-paths": "5.1.4",
    "vitest": "4.1.12"
  },
  "packageManager": "pnpm@10.29.2",
  "engines": {
    "node": "^22.23.4 || >=24.22.1",
    "pnpm": "10.29.2"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "sharp",
      "esbuild",
      "unrs-resolver"
    ],
    "overrides": {
      "sharp": "0.35.5",
      "fast-xml-parser": "^5.7.0",
      "axios": "^1.20.0",
      "form-data@4": "^4.0.6",
      "adm-zip": "^0.6.1",
      "lodash@4": "^4.18.1",
