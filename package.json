      "js-yaml@4": "^4.3.2",
      "fast-uri@3": "^3.1.9",
      "postcss@8": "^8.5.31",
      "nanoid@3": "^3.3.20",
      "dompurify@3": "^3.4.17",
      "picomatch@2": "^2.3.2",
      "picomatch@4": "^4.0.4",
      "form-data@3": "^3.0.5",
      "browserslist@4": "^4.28.7",
      "source-map-js": "^1.2.2",
      "happy-dom": "^21.0.4"
    }
  }
